model MzigoChakula
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["dim_markets","dim_date","dim_commodity","fact_prices"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table dim_markets
ref table dim_date
ref table dim_commodity
ref table fact_prices

