          },
          {
            "name": "month",
            "dataType": "int64",
            "sourceColumn": "month",
            "formatString": "0",
            "lineageTag": "0bfd5857-09ef-4e88-a4a3-2dae6b22d315",
            "summarizeBy": "none"
          },
          {
            "name": "month_name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "sortByColumn": "month",
            "lineageTag": "5f70872b-14fa-4581-bb0e-e64079dd9032"
          },
          {
            "name": "year_month",
            "dataType": "string",
            "sourceColumn": "year_month",
            "lineageTag": "67b97809-6764-44c3-b11b-483465bc595f"
          },
          {
            "name": "quarter",
            "dataType": "string",
            "sourceColumn": "quarter",
            "lineageTag": "4c7aa77c-888d-4c30-938d-b64618c7c67f"
          },
          {
            "name": "season",
