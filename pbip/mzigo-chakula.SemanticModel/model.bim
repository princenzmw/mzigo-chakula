          },
          {
            "name": "price_change_mom_pct",
            "dataType": "double",
            "sourceColumn": "price_change_mom_pct",
            "formatString": "0.00",
            "lineageTag": "ffee9bba-3723-45f5-a46b-707ffac0cbfb",
            "summarizeBy": "none"
          },
          {
            "name": "z_score",
            "dataType": "double",
            "sourceColumn": "z_score",
            "formatString": "0.0000",
            "lineageTag": "193e21c5-16c1-4b0f-878c-f84aa9d0304a",
            "summarizeBy": "none"
          },
          {
            "name": "is_outlier",
            "dataType": "boolean",
            "sourceColumn": "is_outlier",
            "lineageTag": "4643dc46-de1e-436f-888d-f2a0c2050bd2"
          }
        ],
        "partitions": [
          {
            "name": "fact_prices",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "// Mzigo Chakula: fact_prices (166,362 market-month-commodity records from 55,454 physical market observations)\n// Update CsvPath if moving the repository to a different folder.\nlet\n    CsvPath = \"D:\\COURSES\\FS2026\\DSA3050A TT17 BusIntDViz\\Projects\\mzigo-chakula\\data\\raw\\KEN_RTFP_mkt_2007_2026-10-05.csv\",\n    Source = Csv.Document(File.Contents(CsvPath), [Delimiter=\",\", Columns=46, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    SelectedCols = Table.SelectColumns(PromotedHeaders, {\"geo_id\", \"mkt_name\", \"price_date\", \"year\", \"month\", \"c_food_price_index\", \"inflation_food_price_index\", \"c_beans\", \"o_beans\", \"h_beans\", \"l_beans\", \"beans\", \"inflation_beans\", \"trust_beans\", \"c_maize_fao\", \"o_maize_fao\", \"h_maize_fao\", \"l_maize_fao\", \"maize_fao\", \"inflation_maize_fao\", \"trust_maize_fao\", \"c_livestock_goat_s_fao\", \"o_livestock_goat_s_fao\", \"h_livestock_goat_s_fao\", \"l_livestock_goat_s_fao\", \"livestock_goat_s_fao\", \"inflation_livestock_goat_s_fao\", \"trust_livestock_goat_s_fao\"}),\n    TypedBase = Table.TransformColumnTypes(\n        SelectedCols,\n        {\n            {\"geo_id\", type text},\n            {\"mkt_name\", type text},\n            {\"price_date\", type date},\n            {\"year\", Int64.Type},\n            {\"month\", Int64.Type},\n            {\"c_food_price_index\", type number},\n            {\"inflation_food_price_index\", type number},\n            {\"c_beans\", type number},\n            {\"o_beans\", type number},\n            {\"h_beans\", type number},\n            {\"l_beans\", type number},\n            {\"beans\", type number},\n            {\"inflation_beans\", type number},\n            {\"trust_beans\", type number},\n            {\"c_maize_fao\", type number},\n            {\"o_maize_fao\", type number},\n            {\"h_maize_fao\", type number},\n            {\"l_maize_fao\", type number},\n            {\"maize_fao\", type number},\n            {\"inflation_maize_fao\", type number},\n            {\"trust_maize_fao\", type number},\n            {\"c_livestock_goat_s_fao\", type number},\n            {\"o_livestock_goat_s_fao\", type number},\n            {\"h_livestock_goat_s_fao\", type number},\n            {\"l_livestock_goat_s_fao\", type number},\n            {\"livestock_goat_s_fao\", type number},\n            {\"inflation_livestock_goat_s_fao\", type number},\n            {\"trust_livestock_goat_s_fao\", type number}\n        },\n        \"en-US\"\n    ),\n    FilteredPhysical = Table.SelectRows(TypedBase, each [geo_id] <> \"gid_ken_national_average\" and [mkt_name] <> \"Market Average\" and ([c_beans] <> null or [c_maize_fao] <> null or [c_livestock_goat_s_fao] <> null)),\n    AddedDateKey = Table.AddColumn(FilteredPhysical, \"date_key\", each [year] * 10000 + [month] * 100 + Date.Day([price_date]), Int64.Type),\n    RenamedBase = Table.RenameColumns(AddedDateKey, {{\"geo_id\", \"mkt_id\"}, {\"c_food_price_index\", \"food_price_index\"}}),\n    ProjectCommodity = (base as table, cid as text, closeCol as text, openCol as text, highCol as text, lowCol as text, rawCol as text, inflCol as text, trustCol as text) as table =>\n        let\n            Subset = Table.SelectColumns(base, {\"mkt_id\", \"date_key\", \"food_price_index\", \"inflation_food_price_index\", closeCol, openCol, highCol, lowCol, rawCol, inflCol, trustCol}),\n            Renamed = Table.RenameColumns(Subset, {\n                {closeCol, \"price_value\"},\n                {openCol, \"open_price\"},\n                {highCol, \"high_price\"},\n                {lowCol, \"low_price\"},\n                {rawCol, \"raw_spot_price\"},\n                {inflCol, \"commodity_inflation_yoy\"},\n                {trustCol, \"trust_score\"}\n            }),\n            NonNullClose = Table.SelectRows(Renamed, each [price_value] <> null),\n            WithCid = Table.AddColumn(NonNullClose, \"commodity_id\", each cid, type text)\n        in\n            WithCid,\n    Unpivoted = Table.Combine({\n        ProjectCommodity(RenamedBase, \"beans\", \"c_beans\", \"o_beans\", \"h_beans\", \"l_beans\", \"beans\", \"inflation_beans\", \"trust_beans\"),\n        ProjectCommodity(RenamedBase, \"maize_fao\", \"c_maize_fao\", \"o_maize_fao\", \"h_maize_fao\", \"l_maize_fao\", \"maize_fao\", \"inflation_maize_fao\", \"trust_maize_fao\"),\n        ProjectCommodity(RenamedBase, \"livestock_goat_s_fao\", \"c_livestock_goat_s_fao\", \"o_livestock_goat_s_fao\", \"h_livestock_goat_s_fao\", \"l_livestock_goat_s_fao\", \"livestock_goat_s_fao\", \"inflation_livestock_goat_s_fao\", \"trust_livestock_goat_s_fao\")\n    }),\n    AddedPriceId = Table.AddColumn(Unpivoted, \"price_id\", each [mkt_id] & \"_\" & Text.From([date_key]) & \"_\" & [commodity_id], type text),\n    EnrichSeries = (grp as table) as table =>\n        let\n            Sorted = Table.Sort(grp, {{\"date_key\", Order.Ascending}}),\n            PriceList = List.Buffer(Sorted[price_value]),\n            MeanPrice = List.Average(PriceList),\n            StdPrice = List.StandardDeviation(PriceList),\n            Indexed = Table.AddIndexColumn(Sorted, \"_idx\", 0, 1, Int64.Type),\n            WithMom = Table.AddColumn(Indexed, \"price_change_mom\", each if [_idx] = 0 then null else Number.Round([price_value] - PriceList{[_idx] - 1}, 4), type number),\n            WithMomPct = Table.AddColumn(WithMom, \"price_change_mom_pct\", each if [_idx] = 0 or PriceList{[_idx] - 1} = 0 then null else Number.Round(([price_value] - PriceList{[_idx] - 1}) / PriceList{[_idx] - 1} * 100, 4), type number),\n            WithZ = Table.AddColumn(WithMomPct, \"z_score\", each if StdPrice = null or StdPrice = 0 then 0 else Number.Round(([price_value] - MeanPrice) / StdPrice, 4), type number),\n            WithOutlier = Table.AddColumn(WithZ, \"is_outlier\", each (if [price_change_mom_pct] <> null and Number.Abs([price_change_mom_pct]) > 50 then true else false) or Number.Abs([z_score]) > 3, type logical),\n            Cleaned = Table.RemoveColumns(WithOutlier, {\"_idx\"})\n        in\n            Cleaned,\n    Grouped = Table.Group(AddedPriceId, {\"mkt_id\", \"commodity_id\"}, {{\"Series\", each EnrichSeries(_), type table}}),\n    CombinedSeries = Table.Combine(Grouped[Series]),\n    FinalTyped = Table.TransformColumnTypes(\n        CombinedSeries,\n        {\n            {\"price_id\", type text},\n            {\"mkt_id\", type text},\n            {\"date_key\", Int64.Type},\n            {\"commodity_id\", type text},\n            {\"price_value\", type number},\n            {\"open_price\", type number},\n            {\"high_price\", type number},\n            {\"low_price\", type number},\n            {\"raw_spot_price\", type number},\n            {\"commodity_inflation_yoy\", type number},\n            {\"food_price_index\", type number},\n            {\"inflation_food_price_index\", type number},\n            {\"trust_score\", type number},\n            {\"price_change_mom\", type number},\n            {\"price_change_mom_pct\", type number},\n            {\"z_score\", type number},\n            {\"is_outlier\", type logical}\n        },\n        \"en-US\"\n    ),\n    ReorderedCols = Table.ReorderColumns(FinalTyped, {\"price_id\", \"mkt_id\", \"date_key\", \"commodity_id\", \"price_value\", \"open_price\", \"high_price\", \"low_price\", \"raw_spot_price\", \"commodity_inflation_yoy\", \"food_price_index\", \"inflation_food_price_index\", \"trust_score\", \"price_change_mom\", \"price_change_mom_pct\", \"z_score\", \"is_outlier\"})\nin\n    ReorderedCols"
            }
          }
        ],
        "measures": [
          {
            "name": "Avg Price (KES)",
            "description": "Mean closing commodity price in KES within the active filter context.",
            "expression": "AVERAGE(fact_prices[price_value])",
            "formatString": "#,0.00",
            "displayFolder": "01. Core Price & Index",
            "lineageTag": "1c4a85c9-40d2-4e8b-825f-4cf5f0f800b5"
          },
          {
            "name": "National Food Price Index",
            "description": "Grain-safe mean closing composite food price index averaged at the distinct (mkt_id, date_key) grain so unpivoting three commodities does not triple-count index weight.",
            "expression": "AVERAGEX(\n    SUMMARIZE(fact_prices, fact_prices[mkt_id], fact_prices[date_key]),\n    CALCULATE(AVERAGE(fact_prices[food_price_index]))\n)",
            "formatString": "0.00",
            "displayFolder": "01. Core Price & Index",
            "lineageTag": "d281bfff-7bfd-4d70-aabe-f1c142214dce"
          },
          {
            "name": "Prior Year Price (KES)",
            "description": "Mean closing commodity price shifted back exactly 12 months via SAMEPERIODLASTYEAR.",
            "expression": "CALCULATE([Avg Price (KES)], SAMEPERIODLASTYEAR(dim_date[full_date]))",
            "formatString": "#,0.00",
            "displayFolder": "02. Time Intelligence & Growth",
            "lineageTag": "a8f13670-0d7b-42d2-b777-67ca22376140"
          },
          {
            "name": "YoY Inflation %",
            "description": "Year-over-year percentage change in the grain-safe composite food price index.",
            "expression": "VAR CurrentIdx = [National Food Price Index]\nVAR PriorYearIdx = CALCULATE([National Food Price Index], SAMEPERIODLASTYEAR(dim_date[full_date]))\nRETURN\n    DIVIDE(CurrentIdx - PriorYearIdx, PriorYearIdx)",
            "formatString": "0.00%",
            "displayFolder": "02. Time Intelligence & Growth",
            "lineageTag": "4cfd368b-0ee0-4bc5-a425-5333888498a9"
          },
          {
            "name": "Commodity YoY Inflation %",
            "description": "Year-over-year percentage change in average commodity price (KES).",
            "expression": "VAR CurrentPrice = [Avg Price (KES)]\nVAR PriorYearPrice = [Prior Year Price (KES)]\nRETURN\n    DIVIDE(CurrentPrice - PriorYearPrice, PriorYearPrice)",
            "formatString": "0.00%",
            "displayFolder": "02. Time Intelligence & Growth",
            "lineageTag": "99d8bfdf-557f-4a8a-91c0-7f478b14f7e7"
          },
          {
            "name": "MoM Change %",
            "description": "Month-over-month percentage change in average commodity price relative to the prior month.",
            "expression": "VAR CurrentPrice = [Avg Price (KES)]\nVAR PriorMonthPrice = CALCULATE([Avg Price (KES)], DATEADD(dim_date[full_date], -1, MONTH))\nRETURN\n    DIVIDE(CurrentPrice - PriorMonthPrice, PriorMonthPrice)",
            "formatString": "0.00%",
            "displayFolder": "02. Time Intelligence & Growth",
            "lineageTag": "e8ba61f2-ce49-4516-8c35-bb140243be69"
          },
          {
            "name": "Price Volatility (KES)",
            "description": "Sample standard deviation of monthly closing prices in KES.",
            "expression": "STDEV.S(fact_prices[price_value])",
            "formatString": "#,0.00",
            "displayFolder": "03. Risk & Seasonality",
            "lineageTag": "c01f3b5c-e807-4060-b8ba-7bbe5a8e8022"
          },
          {
            "name": "Price Volatility CV %",
            "description": "Coefficient of variation allowing unit-free volatility comparisons across commodities and counties.",
            "expression": "DIVIDE([Price Volatility (KES)], [Avg Price (KES)])",
            "formatString": "0.00%",
            "displayFolder": "03. Risk & Seasonality",
            "lineageTag": "1897347c-8bab-4bfa-a329-c70da640093b"
          },
          {
            "name": "Cumulative Index YTD",
            "description": "Year-to-date running mean composite food price index within the calendar year.",
            "expression": "TOTALYTD([National Food Price Index], dim_date[full_date])",
            "formatString": "0.00",
            "displayFolder": "02. Time Intelligence & Growth",
            "lineageTag": "73122316-1383-480c-bf94-ff22fcad54eb"
          },
          {
            "name": "County Inflation Rank",
            "description": "Dense descending rank of Kenyan counties by YoY food index inflation (1 = highest inflation).",
            "expression": "IF(\n    ISINSCOPE(dim_markets[adm2_name]),\n    RANKX(ALL(dim_markets[adm2_name]), [YoY Inflation %], , DESC, Dense)\n)",
            "formatString": "0",
            "displayFolder": "04. Coverage & Disparities",
            "lineageTag": "9af973b1-b2a3-477d-bf5a-8cd866b4037c"
          },
          {
            "name": "Data Completeness %",
            "description": "Share of expected market-month-commodity cells populated with non-null modelled closing prices.",
            "expression": "VAR ObservedRows = COUNTROWS(fact_prices)\nVAR ExpectedRows = COUNTROWS(dim_markets) * COUNTROWS(dim_date) * COUNTROWS(dim_commodity)\nRETURN\n    DIVIDE(ObservedRows, ExpectedRows)",
            "formatString": "0.00%",
            "displayFolder": "04. Coverage & Disparities",
            "lineageTag": "ad0fe60c-dbf8-4a50-905e-1bfde4e708c7"
          },
          {
            "name": "Survey Coverage Rate %",
            "description": "Share of market-month-commodity records backed by a direct raw field survey observation.",
            "expression": "DIVIDE(COUNT(fact_prices[raw_spot_price]), COUNTROWS(fact_prices))",
            "formatString": "0.00%",
            "displayFolder": "04. Coverage & Disparities",
            "lineageTag": "f5134d80-65bc-4c01-b235-78fec74a35a0"
          },
          {
            "name": "Affordability Gap (KES)",
            "description": "Local price premium or discount in KES compared to the national all-market mean.",
            "expression": "VAR LocalAvg = [Avg Price (KES)]\nVAR NationalAvg = CALCULATE([Avg Price (KES)], ALL(dim_markets))\nRETURN\n    LocalAvg - NationalAvg",
            "formatString": "#,0.00",
            "displayFolder": "04. Coverage & Disparities",
            "lineageTag": "ed0576fa-32d3-4b14-89da-65a3d1c723a5"
          },
          {
            "name": "Seasonal Index",
            "description": "Ratio of a calendar month or season average price to the all-month average (>1.000 = seasonal peak).",
            "expression": "VAR CurrentMonthAvg = [Avg Price (KES)]\nVAR AllMonthsAvg = CALCULATE([Avg Price (KES)], ALL(dim_date[month], dim_date[month_name], dim_date[season], dim_date[quarter]))\nRETURN\n    DIVIDE(CurrentMonthAvg, AllMonthsAvg)",
            "formatString": "0.000",
            "displayFolder": "03. Risk & Seasonality",
            "lineageTag": "a1df5330-c83d-41f0-8e8e-4bf660ce225e"
          },
          {
            "name": "12-Month Rolling Avg (KES)",
            "description": "Trailing 12-month smoothed commodity price average ending at the selected period.",
            "expression": "AVERAGEX(\n    DATESINPERIOD(dim_date[full_date], MAX(dim_date[full_date]), -12, MONTH),\n    [Avg Price (KES)]\n)",
            "formatString": "#,0.00",
            "displayFolder": "02. Time Intelligence & Growth",
            "lineageTag": "380d8d02-cf07-4883-8519-821226119642"
          }
        ]
      }
    ],
