            "description": "Kenyan agricultural seasonality window.",
            "sourceColumn": "season",
            "lineageTag": "5c10ad20-1621-4bce-ac3d-4c2900d9748d"
          },
          {
            "name": "is_recent",
            "dataType": "boolean",
            "sourceColumn": "is_recent",
            "lineageTag": "95579c3b-b5f3-4f1d-b54b-799ef4720830"
          },
          {
            "name": "is_last_36m",
            "dataType": "boolean",
            "sourceColumn": "is_last_36m",
            "lineageTag": "72bd04ce-801b-4cd9-b5e0-18fcb6802085"
          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "// Mzigo Chakula: dim_date (238 consecutive monthly periods from 2007-01-01 to 2026-10-01)\n// Update CsvPath if moving the repository to a different folder.\nlet\n    CsvPath = \"D:\\COURSES\\FS2026\\DSA3050A TT17 BusIntDViz\\Projects\\mzigo-chakula\\data\\raw\\KEN_RTFP_mkt_2007_2026-10-05.csv\",\n    Source = Csv.Document(File.Contents(CsvPath), [Delimiter=\",\", Columns=46, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    SelectedDateCols = Table.SelectColumns(PromotedHeaders, {\"price_date\", \"year\", \"month\"}),\n    DistinctDates = Table.Distinct(SelectedDateCols, {\"price_date\"}),\n    TypedDates = Table.TransformColumnTypes(DistinctDates, {{\"price_date\", type date}, {\"year\", Int64.Type}, {\"month\", Int64.Type}}, \"en-US\"),\n    RenamedDateCol = Table.RenameColumns(TypedDates, {{\"price_date\", \"full_date\"}}),\n    SortedDates = Table.Sort(RenamedDateCol, {{\"full_date\", Order.Ascending}}),\n    AddedDateKey = Table.AddColumn(SortedDates, \"date_key\", each [year] * 10000 + [month] * 100 + Date.Day([full_date]), Int64.Type),\n    AddedMonthName = Table.AddColumn(AddedDateKey, \"month_name\", each Date.ToText([full_date], \"MMM\", \"en-US\"), type text),\n    AddedYearMonth = Table.AddColumn(AddedMonthName, \"year_month\", each Date.ToText([full_date], \"yyyy-MM\", \"en-US\"), type text),\n    AddedQuarter = Table.AddColumn(AddedYearMonth, \"quarter\", each \"Q\" & Text.From(Date.QuarterOfYear([full_date])), type text),\n    AddedSeason = Table.AddColumn(\n        AddedQuarter,\n        \"season\",\n        each if List.Contains({1, 2}, [month]) then \"Hot Dry / Lean (Jan-Feb)\" else if List.Contains({3, 4, 5}, [month]) then \"Long Rains (Mar-May)\" else if List.Contains({6, 7, 8, 9}, [month]) then \"Cool Dry / Harvest (Jun-Sep)\" else \"Short Rains (Oct-Dec)\",\n        type text\n    ),\n    MaxDate = List.Max(AddedSeason[full_date]),\n    AddedIsRecent = Table.AddColumn(AddedSeason, \"is_recent\", each [full_date] >= Date.AddMonths(MaxDate, -11), type logical),\n    AddedIsLast36M = Table.AddColumn(AddedIsRecent, \"is_last_36m\", each [full_date] >= Date.AddMonths(MaxDate, -35), type logical),\n    ReorderedCols = Table.ReorderColumns(AddedIsLast36M, {\"date_key\", \"full_date\", \"year\", \"month\", \"month_name\", \"year_month\", \"quarter\", \"season\", \"is_recent\", \"is_last_36m\"})\nin\n    ReorderedCols"
            }
          }
        ]
      },
      {
